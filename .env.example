# Server-side Gemini API key used by Vercel Serverless Function (/api/chat)
# (Kept strictly on the server; never bundled into the client)
GEMINI_API_KEY=
# Optional: Model name for /api/chat (defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Optional Supabase-backed resume loading, it is preferred to code the resume in backend
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=SophiaCareer
SUPABASE_FILE_PATH=resume.md

# Vercel Serverless Function contact notifications via Pushover
PUSHOVER_USER_KEY=
PUSHOVER_API_TOKEN=

# Fallback: Gmail SMTP for email notifications
GMAIL_USER=
GMAIL_APP_PASS=
CONTACT_TO_EMAIL=